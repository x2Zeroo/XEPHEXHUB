-- Toggle UI แสดง/ซ่อน
local uiVisible = true
logoBtn.MouseButton1Click:Connect(function()
    uiVisible = not uiVisible
    for _, child in ipairs(uiContainer:GetChildren()) do
        -- เนื่องจาก Folder ไม่มี property Visible, เราสนใจเฉพาะ GuiObjects ข้างใน
        if child:IsA("GuiObject") then
            child.Visible = uiVisible
        end
        -- ถ้า Folder มี children (เรเก็บ UI ตรงๆ เป็น children ของ uiContainer)
        for _, sub in ipairs(child:GetChildren()) do
            if sub:IsA("GuiObject") then
                sub.Visible = uiVisible
            end
        end
    end
end)

-- Drawing FOV circle (ถ้ามี Drawing)
local drawingAvailable, Drawing = pcall(function() return Drawing end)
local fovCircle
if drawingAvailable and Drawing then
    fovCircle = Drawing.new("Circle")
    fovCircle.Radius = FOV_Radius
    fovCircle.Color = Color3.fromRGB(255, 0, 0)
    fovCircle.Thickness = 2
    fovCircle.Filled = false
    fovCircle.Visible = true
else
    fovCircle = nil
end

-- เป้าปัจจุบัน
local currentTarget = nil

-- เก็บ highlight references เพื่อเคลียร์
local highlights = {} -- key = Player, value = Highlight instance

local function safeDestroy(obj)
    if obj and obj.Parent then
        pcall(function() obj:Destroy() end)
    end
end

local function clearHighlights()
    for plr, h in pairs(highlights) do
        safeDestroy(h)
    end
    highlights = {}
end

local function createOrUpdateHighlight(plr)
    if not plr or not plr.Character then return end

    -- ถ้ามี highlight เดิม แต่ Adornee ไม่ใช่ character ปัจจุบัน ให้ทำลายและสร้างใหม่
    local existing = highlights[plr]
    if existing then
        -- ถ้า Adornee ยังเป็น character ปัจจุบัน ให้รีเทิร์นเลย
        if existing.Adornee == plr.Character and existing.Parent then
            return
        else
            safeDestroy(existing)
            highlights[plr] = nil
        end
    end

    local ok, hl = pcall(function()
        local highlight = Instance.new("Highlight")
        highlight.Name = "XNON_ESPHighlight"
        highlight.Adornee = plr.Character
        highlight.FillTransparency = 0.6
        highlight.OutlineTransparency = 0
        if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            highlight.FillColor = Color3.fromRGB(0, 120, 255)
        else
            highlight.FillColor = Color3.fromRGB(255, 30, 30)
        end
        highlight.Parent = plr.Character
        return highlight
    end)
    if ok and hl then
        highlights[plr] = hl
    end
end

local function updateESP()
    if not ESPOn then
        clearHighlights()
        return
    end
    -- สร้าง/อัปเดต highlight ให้ผู้เล่นทุกคน (ยกเว้น LocalPlayer)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            createOrUpdateHighlight(plr)
        end
    end
end

-- 🌐 อัปเดต ESP อัตโนมัติทุก 1 วิ (loop)
task.spawn(function()
    while true do
        task.wait(1)
        if ESPOn then
            updateESP()
        end
    end
end)

-- เมื่อ player spawn ใหม่ ให้สร้าง/อัปเดต ESP ให้ทันที (respawn-safe)
local function hookCharacterAdded(plr)
    -- ป้องกัน double-hook ถ้าเรียกซ้ำ
    if not plr or not plr:IsA("Player") then return end
    -- เช็คว่ามี already connection mark
    if plr:FindFirstChild("__XNON_Hooked") then return end
    local marker = Instance.new("BoolValue")
    marker.Name = "__XNON_Hooked"
    marker.Value = true
    marker.Parent = plr

    plr.CharacterAdded:Connect(function()
        -- นิดหน่อยหน่วงให้ character โหลดเสร็จ
        task.wait(0.4)
        if ESPOn then
            createOrUpdateHighlight(plr)
        end
    end)
end

-- Hook ทุก player ปัจจุบัน (ยกเว้น local)
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        hookCharacterAdded(plr)
        if ESPOn and plr.Character then
            createOrUpdateHighlight(plr)
        end
    end
end

-- เมื่อมี player เข้ามาใหม่ ให้ hook และ สร้าง ESP ถ้าเปิดอยู่
Players.PlayerAdded:Connect(function(plr)
    if plr ~= LocalPlayer then
        hookCharacterAdded(plr)
        -- ให้หน่วงเล็กน้อยแล้วสร้าง highlight ถ้ามี character อยู่แล้ว
        task.wait(0.3)
        if ESPOn and plr.Character then
            createOrUpdateHighlight(plr)
        end
    end
end)

-- เมื่อ player ออก ให้ลบ highlight ของเค้า
Players.PlayerRemoving:Connect(function(plr)
    if highlights[plr] then
        safeDestroy(highlights[plr])
        highlights[plr] = nil
    end
    if currentTarget == plr then currentTarget = nil end
end)

-- target validation และ selection
local function isValidTarget(plr)
    if not plr or not plr.Character then return false end
    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    local head = plr.Character:FindFirstChild("Head")
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    if LockPart == "Head" and not head then return false end
    if LockPart ~= "Head" and not root then return false end
    return true
end

local function getBestTarget()
    local best, bestFov = nil, math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
    if not myHead then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isValidTarget(plr) then
            if not LockAll and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                -- ข้ามเพื่อนทีม
            else
                local targetPart = (LockPart == "Head") and plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        local dist = (targetPart.Position - myHead.Position).Magnitude
                        if fovDist <= FOV_Radius and dist <= MaxLockDistance then
                            if fovDist < bestFov then
                                bestFov = fovDist
                                best = plr
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

local function targetStillValid(plr)
    if not isValidTarget(plr) then return false end
    local targetPart = (LockPart == "Head") and plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return false end
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
    if not myHead then return false end
    local dist = (targetPart.Position - myHead.Position).Magnitude
    if fovDist > FOV_Radius or dist > MaxLockDistance then return false end
    if not LockAll and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return false end
    return true
end

-- Update FOV/MaxDistance จาก TextBox (เมื่อกด Enter หรือ FocusLost)
local function applyFOVFromTextbox()
    local n = tonumber(fovTextbox.Text)
    if n and n > 0 then
        FOV_Radius = n
        if fovCircle then fovCircle.Radius = FOV_Radius end
    else
        fovTextbox.Text = tostring(FOV_Radius)
    end
end

local function applyDistFromTextbox()
    local n = tonumber(distTextbox.Text)
    if n and n > 0 then
        MaxLockDistance = n
    else
        distTextbox.Text = tostring(MaxLockDistance)
    end
end

fovTextbox.FocusLost:Connect(function(enter)
    if enter then applyFOVFromTextbox() end
end)
distTextbox.FocusLost:Connect(function(enter)
    if enter then applyDistFromTextbox() end
end)

-- Buttons behaviour
aimbotBtn.MouseButton1Click:Connect(function()
    AimbotOn = not AimbotOn
    aimbotBtn.Text = AimbotOn and "Aimbot: ON" or "Aimbot: OFF"
    aimbotBtn.BackgroundColor3 = AimbotOn and Color3.fromRGB(200,50,50) or Color3.fromRGB(40,40,40)
end)

espBtn.MouseButton1Click:Connect(function()
    ESPOn = not ESPOn
    espBtn.Text = ESPOn and "ESP: ON" or "ESP: OFF"
    espBtn.BackgroundColor3 = ESPOn and Color3.fromRGB(0,150,255) or Color3.fromRGB(40,40,40)
    if not ESPOn then
        clearHighlights()
    else
        updateESP()
    end
end)

lockModeBtn.MouseButton1Click:Connect(function()
    LockAll = not LockAll
    lockModeBtn.Text = LockAll and "Lock: ALL" or "Lock: Enemies"
    lockModeBtn.BackgroundColor3 = LockAll and Color3.fromRGB(200,120,0) or Color3.fromRGB(40,40,40)
end)

lockPartBtn.MouseButton1Click:Connect(function()
    if LockPart == "Head" then
        LockPart = "HumanoidRootPart"
        lockPartBtn.Text = "Lock Part: Body"
    else
        LockPart = "Head"
        lockPartBtn.Text = "Lock Part: Head"
    end
end)

-- Main loop: หาเป้า และ hard-lock ถ้า AimbotOn
RunService.RenderStepped:Connect(function()
    -- update drawing circle
    if fovCircle then
        local vx, vy = Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2
        fovCircle.Position = Vector2.new(vx, vy)
        fovCircle.Radius = FOV_Radius
        fovCircle.Visible = true
    end

    if not AimbotOn then
        currentTarget = nil
        return
    end

    if not currentTarget or not targetStillValid(currentTarget) then
        currentTarget = getBestTarget()
    end

    if currentTarget and targetStillValid(currentTarget) and currentTarget.Character then
        local targetPart = (LockPart == "Head") and currentTarget.Character:FindFirstChild("Head") or currentTarget.Character:FindFirstChild("HumanoidRootPart")
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    else
        currentTarget = nil
    end
end)

-- ถ้ respawn ตัวเอง ให้รีเซ็ตเป้า และ clear highlight (local)
Players.LocalPlayer.CharacterAdded:Connect(function()
    currentTarget = nil
    clearHighlights()
end)