local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

-- ตั้งต้น
local AimbotOn = false
local ESPOn = false
local LockAll = false             -- false -> ไม่ล็อคเพื่อนทีม
local FOV_Radius = 120            -- default (px)
local MaxLockDistance = 2000      -- default (studs)
local LockPart = "Head"           -- "Head" or "HumanoidRootPart"

