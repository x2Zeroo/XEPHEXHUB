-- ฟังก์ชันสร้าง UI
local function MakeButton(name, posY, text)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Size = UDim2.new(0, 160, 0, 36)
    b.Position = UDim2.new(0, 12, 0, posY)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.Text = text
    b.Font = Enum.Font.SourceSansSemibold
    b.TextScaled = true
    b.BorderSizePixel = 0
    b.Parent = uiContainer
    return b
end

local function MakeLabel(posY, text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(0, 160, 0, 20)
    l.Position = UDim2.new(0, 12, 0, posY)
    l.BackgroundTransparency = 1
    l.TextColor3 = Color3.fromRGB(220,220,220)
    l.Text = text
    l.Font = Enum.Font.SourceSans
    l.TextSize = 14
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = uiContainer
    return l
end

local function MakeTextbox(posY, placeholder, default)
    local tb = Instance.new("TextBox")
    tb.Size = UDim2.new(0, 160, 0, 28)
    tb.Position = UDim2.new(0, 12, 0, posY)
    tb.BackgroundColor3 = Color3.fromRGB(30,30,30)
    tb.TextColor3 = Color3.fromRGB(255,255,255)
    tb.Text = tostring(default or "")
    tb.PlaceholderText = placeholder
    tb.Font = Enum.Font.SourceSans
    tb.TextSize = 18
    tb.ClearTextOnFocus = false
    tb.Parent = uiContainer
    return tb
end

-- UI Elements
local aimbotBtn = MakeButton("AimbotBtn", 10, "Aimbot: OFF")
local espBtn = MakeButton("ESPBtn", 56, "ESP: OFF")
local lockModeBtn = MakeButton("LockModeBtn", 102, "Lock: Enemies")
local lockPartBtn = MakeButton("LockPartBtn", 148, "Lock Part: Head")
MakeLabel(194, "FOV (px):")
